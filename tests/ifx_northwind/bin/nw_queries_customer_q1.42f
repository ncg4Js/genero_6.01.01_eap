<?xml version='1.0' encoding='windows-1252'?>
<Form name="nw_queries_customer_q1" build="6.01.00" sqlDbName="northwind" text="Query 1 - Customers" width="108" height="3">
  <VBox>
    <Group name="g_search" text="Search">
