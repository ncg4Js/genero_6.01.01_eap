<?xml version='1.0' encoding='windows-1252'?>
<Form name="nw_queries_customer_q3" build="6.01.00" sqlDbName="northwind" text="Query 3 - Sales per customer" width="88" height="2">
  <VBox>
    <Group name="g_param" text="Parameter">
      <Grid width="46" height="1">
        <Label text="Minimum sales" posY="0" posX="1" gridWidth="14"/>
        <FormField name="formonly.minsales" colName="minsales" sqlType="DECIMAL(12,2)" fieldId="0" sqlTabName="formonly" tabIndex="1">
          <Edit width="13" posY="0" posX="16" gridWidth="13"/>
        </FormField>
        <Label text="Rows" posY="0" posX="33" gridWidth="5"/>
        <FormField name="formonly.rowcount" colName="rowcount" sqlType="INTEGER" fieldId="1" sqlTabName="formonly" noEntry="1" tabIndex="2">
          <Edit width="6" posY="0" posX="39" gridWidth="6"/>
        </FormField>
      </Grid>
    </Group>
    <Table pageSize="1" name="t_q3" height="16" tabName="sr_q3">
      <TableColumn name="formonly.q3_id" colName="q3_id" fieldId="2" sqlTabName="formonly" text="Id" tabIndex="3">
        <Edit width="5"/>
      </TableColumn>
      <TableColumn name="formonly.q3_company" colName="q3_company" fieldId="3" sqlTabName="formonly" text="Company" tabIndex="4">
        <Edit width="40"/>
      </TableColumn>
      <TableColumn name="formonly.q3_country" colName="q3_country" fieldId="4" sqlTabName="formonly" text="Country" tabIndex="5">
        <Edit width="15"/>
      </TableColumn>
      <TableColumn name="formonly.q3_norders" colName="q3_norders" fieldId="5" sqlTabName="formonly" text="Orders" tabIndex="6">
        <Edit width="7"/>
      </TableColumn>
      <TableColumn name="formonly.q3_total" colName="q3_total" fieldId="6" sqlTabName="formonly" text="Total sales" tabIndex="7">
        <Edit width="15"/>
      </TableColumn>
    </Table>
  </VBox>
  <RecordView tabName="formonly">
    <Link colName="minsales" fieldIdRef="0"/>
    <Link colName="rowcount" fieldIdRef="1"/>
    <Link colName="q3_id" fieldIdRef="2"/>
    <Link colName="q3_company" fieldIdRef="3"/>
    <Link colName="q3_country" fieldIdRef="4"/>
    <Link colName="q3_norders" fieldIdRef="5"/>
    <Link colName="q3_total" fieldIdRef="6"/>
  </RecordView>
</Form>
